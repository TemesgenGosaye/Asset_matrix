<?xml version="1.0" encoding="utf-8"?>
<!--
  Release traffic must always use TLS. The WebView loads the deployed HTTPS
  portal; cleartext is blocked even if a redirect or a third-party link tries
  to downgrade to http://.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
