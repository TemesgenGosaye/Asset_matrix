<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.1+ can use dark navigation-bar icons on the light surface. -->
    <style name="AppTheme.Launch" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/launch_primary</item>
    </style>
</resources>
