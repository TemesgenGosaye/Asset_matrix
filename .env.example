# ─────────────────────────────────────────────────────────────
# MSF Asset and House Portal — environment reference
# Copy to .env and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Public origin of the deployment. Used for absolute URLs in emails,
# QR codes, and OAuth redirects. MUST be https:// on Vercel.
FRONTEND_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Database (Neon) ─────────────────────────────────────────
# Use the DIRECT host, not the `-pooler` host. Prisma 7 removed
# `directUrl`, so this single URL is used for BOTH `prisma migrate
# deploy` and runtime queries.
#
#   pooled (do NOT use): ep-xxx-pooler.<region>.aws.neon.tech
#   direct (use this):    ep-xxx.<region>.aws.neon.tech
#
# src/lib/prisma.ts auto-enables TLS for any `*.neon.tech` host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/assettracker?sslmode=require

# Force TLS on/off. "auto" (unset) enables TLS for Neon/Supabase hosts.
# DATABASE_SSL=true

# PostgreSQL schema holding the tables. Migrations are rewritten at build
# time by prisma/set-schema.mjs to match this value. Keep as "public" for
# a fresh Neon database.
DB_SCHEMA=public

# ── Auth (BetterAuth) ──────────────────────────────────────
# Must match the deployment origin exactly, https included.
BETTER_AUTH_URL=https://your-app.vercel.app

# Comma-separated. Include every origin that may issue auth requests,
# e.g. the Vercel domain plus any custom domain.
# `*` wildcards are supported, e.g. `http://10.3.12.*:3000` to trust a whole
# LAN subnet. A request from an unlisted Origin gets 403 on /sign-in/email.
BETTER_AUTH_TRUSTED_ORIGINS=https://your-app.vercel.app,https://assets.yourcompany.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Crypto ─────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM field encryption.
# openssl rand -hex 32
# Rotating this makes existing encrypted values unreadable.
ENCRYPTION_KEY=

# ── Cron ───────────────────────────────────────────────────
# Sent as the Authorization: Bearer header by Vercel Cron.
# openssl rand -hex 16
# REQUIRED in production — routes reject unauthenticated calls.
CRON_SECRET=

# ── JWT (legacy / non-BetterAuth consumers) ────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Optional integrations ──────────────────────────────────
# All optional: the app runs without them, features degrade gracefully.
# EMAIL_PROVIDER=              # brevo | sendgrid | mailgun | postmark | ses
# EMAIL_FROM=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# SAML_ENTRY_POINT=
# SAML_ISSUER=
# SAML_CERT=
# LDAP_URL=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# STORAGE_PROVIDER=local       # local | s3 | azure
# SENTRY_AUTH_TOKEN=

# ── AI assistant (Meri) ────────────────────────────────────
# At least one provider must be configured or the assistant answers nothing.
# The provider panel in the drawer shows which one is live and lets you re-probe.
#
# Which provider to prefer. `auto` uses Gemini when a key is present and falls
# back to a local Ollama model otherwise, so a laptop with Ollama running and no
# key still works.
#   auto (default) | gemini | ollama | custom
AI_PROVIDER=auto

# Health-probe timeout in ms, used by the status endpoint only.
# AI_PROBE_TIMEOUT_MS=2500

# ── Gemini (cloud) ─────────────────────────────────────────
# Accepted names: GEMINI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ── Ollama (local, offline) ────────────────────────────────
# Ollama's own OpenAI-compatible endpoint. The default is what `ollama serve`
# exposes out of the box; no extra flags needed on the Ollama side.
#   curl http://127.0.0.1:11434/v1/models
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Any tool-capable model you have pulled, e.g. `ollama pull qwen2.5:7b-instruct`
OLLAMA_MODEL=qwen2.5:7b-instruct
# Set true to hide the local provider even when Ollama is running.
# OLLAMA_ENABLED=true
# How long Ollama keeps the model resident between questions. A short value
# frees VRAM sooner; a long one removes the reload pause from the first
# question of a session. `-1` keeps it loaded indefinitely.
# OLLAMA_KEEP_ALIVE=5m
# Context window. Raise it for long transcripts, lower it to save VRAM.
# OLLAMA_NUM_CTX=8192
# Generation cap, which bounds worst-case latency for a slow machine.
# OLLAMA_NUM_PREDICT=1024
# Only needed if the Ollama endpoint sits behind a proxy.
# OLLAMA_API_KEY=

# ── Any other OpenAI-compatible endpoint ───────────────────
# LM Studio, vLLM, llama.cpp, OpenRouter, OpenAI itself, etc. The app talks to
# it with the OpenAI chat-completions shape, so anything that serves
# `/v1/chat/completions` works.
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=
# AI_MODEL=local-model
# AI_PROVIDER_LABEL=LM Studio   # shown in the provider panel
# AI_PROVIDER_KIND=local        # local | cloud


# ── Android / Capacitor (build-time only, not deployed) ────
# Origin the APK's WebView loads. Must be the https deployment above.
# CAPACITOR_SERVER_URL=https://your-app.vercel.app
# Set true ONLY for a LAN/emulator build (http://10.0.2.2:3000).
# CAPACITOR_ALLOW_CLEARTEXT=false
