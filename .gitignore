# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# lockfiles (bun.lock is the canonical lockfile)
package-lock.json
bun.lockb

# React Native / Expo (mobile app)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/ios/
mobile/android/
mobile/web-build/
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/*.orig.*

# local dev logs / runtime artifacts
*.log

# database backups (never commit dumps)
backups/
$log
vitest-failures.txt

# PM2 daemon state (process dump + logs) — kept project-local via PM2_HOME
/.pm2/

# generated one-off backfill report (scripts/backfill-employee-departments.mjs)
employee-department-backfill-report.csv

# Electron desktop client build output
desktop/dist/
desktop/out/
desktop/.vite/

# Release artifacts (Windows installer + Android APK)
dist/

# Android signing material - never commit the keystore or its credentials
android/keystore/
android/keystore.properties
*.jks
*.keystore

# One-off scratch scripts, probes and dumps (never commit)
scripts/tmp-*
scripts/.tmp-*
*.tmp.mjs
tsconfig.probe.json
.tmp-*.sql

.pm2 
.pm2 /
.pm2*

# Build artifacts & cache
.cache/
build-artifacts/
*.apk

