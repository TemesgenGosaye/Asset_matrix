model Employee {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Linked system user (optional) — enables tie-in with login accounts
  userid String? @unique @db.Uuid
  user   user?   @relation("employee_user", fields: [userid], references: [userid], onDelete: SetNull)

  // Department
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Reporting manager (self-reference)
  managerId String?    @db.Uuid
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeManager")

  // House Queue decision ledger (one current allocation thread per employee)
  allocations HouseAllocation[]

  // House Request: the employee's own application for a house. This ticket is
  // what gates entry to the House Queue.
  requests HouseRequest[]

  // Personal information
  employeeNumber String    @unique @db.VarChar(50)
  firstname      String    @db.VarChar(100)
  lastname       String    @db.VarChar(100)
  // No `email` column. It was NOT NULL + unique but the service could not meet
  // the constraint when HR left the address out, so it synthesised
  // `<empid-slug>@placeholder.invalid` and reported it for later correction.
  // Nobody ever corrected it, and those addresses cannot receive mail. Nothing
  // authenticates against this column: BetterAuth signs users in on
  // `user.email`, and an Employee is tied to a login account by `Employee.userid`.
  // See migration 20261004000000_drop_employee_email.
  phone          String?   @db.VarChar(25)
  dateOfBirth    DateTime? @db.Date
  gender         Gender?
  nationalId     String?   @db.VarChar(64)
  address        String?   @db.VarChar(255)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  postalCode     String?   @db.VarChar(20)

  // Employment information
  jobTitle         String?   @db.VarChar(100)
  employmentType   String    @default("full_time") @db.VarChar(30)
  employmentStatus String    @default("active") @db.VarChar(30)
  jobGrade         Int?      @db.SmallInt
  hireDate         DateTime? @db.Date
  terminationDate  DateTime? @db.Date
  notes            String?   @db.VarChar(1000)

  // Housing indicators (used by the House Queue eligibility engine)
  maritalStatus    MaritalStatus?
  familySize       Int?           @db.SmallInt
  disabilityStatus Boolean        @default(false)

  // Soft delete
  deletedAt DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, nationalId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([departmentId])
  @@index([organizationId, departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([organizationId, jobGrade])
  @@index([organizationId, lastname, firstname])
  @@schema("public")
}

/**
 * House Request — the employee's own application for a house.
 * WHY: the House Queue must only ever score, rank and list employees who have
 * actually submitted a request. Previously the engine loaded every active
 * employee, so the queue was a staff directory wearing a ranking table. This
 * table is the ticket that gates queue entry.
 * Only `submitted` rows are active and place an employee in the queue; a
 * `cancelled` request releases the employee to file again. The one-active
 * guarantee is enforced by the partial unique index on
 * `(organizationId, employeeId) WHERE status = 'submitted'`, which Prisma
 * cannot express — the service layer turns a violation into a 409.
 */
model HouseRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  employeeId     String    @db.Uuid
  // Justification for the request. Length is bounded by a CHECK constraint as
  // well as by Zod, so a blank application is rejected at the storage layer.
  remarks        String    @db.VarChar(1000)
  status         String    @default("submitted") @db.VarChar(20)
  submittedBy    String?   @db.Uuid
  decidedAt      DateTime? @db.Timestamp(6)
  decidedBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, employeeId])
  @@index([employeeId])
  @@index([organizationId, createdAt])
  @@map("house_requests")
  @@schema("public")
}

/**
 * Termination receipt — the snapshot a house handback receipt prints from.
 * A receipt is a signed document, so "print it again" must reproduce the
 * original, not re-derive today's truth. Nothing here is editable and nothing is
 * recomputed: the damage lines, their costs, the total and the note are copied
 * verbatim from the completed inspection at the moment of first print and then
 * frozen. A later correction is a new inspection, not an edit to this row.
 * `inspectionId` is unique, so the snapshot is taken exactly once. Reprints
 * read the existing row; they never overwrite it, which is what makes a reprint
 * match the original even after the underlying inspection has been archived.
 */
model HouseTerminationReceipt {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  // The completed inspection this receipt was printed from.
  inspectionId String @unique @db.Uuid
  allocationId String @db.Uuid
  householdId  String @db.Uuid

  /// Form/serial number printed in the receipt header. Also the external reference.
  receiptNo String @db.VarChar(40)

  /// Frozen damage lines: [{ key, label, labelAm, cost }] — damaged parts only.
  damageSnapshot  Json
  /// Frozen sum of the lines above. Stored so the printed total is a read.
  totalDamageCost Decimal @db.Decimal(12, 2)
  /// Frozen condition note; null when the inspector left it blank.
  conditionNote   String? @db.VarChar(1000)

  // When the evidence existed, versus when it was first put on paper. These are
  // separate facts: a receipt can be filed months after the handback.
  completedAt DateTime @db.Timestamp(6)
  printedAt   DateTime @default(now()) @db.Timestamp(6)
  printedBy   String?  @db.Uuid
  /// Incremented on every reprint, so the copy in the file can be told apart.
  printCount  Int      @default(1) @db.Integer

  createdAt DateTime @default(now()) @db.Timestamp(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection   HouseInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  household    Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  allocation   HouseAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([allocationId])
  @@index([householdId])
  @@index([printedAt])
  @@map("house_termination_receipts")
  @@schema("public")
}

model Household {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  srNo            Int                  @unique @default(autoincrement())
  hid             String               @db.VarChar(50)
  houseType       String               @db.VarChar(20)
  staffCategory   String?              @db.VarChar(10)
  houseNumber     String               @db.VarChar(50)
  rgType          String               @db.VarChar(20)
  locationId      String?              @db.Uuid
  locationName    String?              @db.VarChar(255)
  status          String               @default("Active") @db.VarChar(20)
  // Occupancy state managed by the House Queue decision service (allocated
  // → Occupied, released → Vacant) and the register's activate/deactivate
  // path (→ Vacant / Maintenance). New houses start Vacant.
  occupancyStatus HouseOccupancyStatus @default(Vacant)

  // Inside items (structured)
  bedCount    Int @default(0)
  chairsCount Int @default(0)
  lockerCount Int @default(0)
  tablesCount Int @default(0)

  // Damage information (required only when Status = Inactive)
  damageWindow      Boolean @default(false)
  damageDoor        Boolean @default(false)
  damageWaterPanel  Boolean @default(false)
  damageRoof        Boolean @default(false)
  damageWall        Boolean @default(false)
  damageElectricity Boolean @default(false)
  damageNotes       String? @db.VarChar(1000)

  // Multi-tenancy & audit
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       location?    @relation(fields: [locationId], references: [locationid], onDelete: SetNull)
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt @db.Timestamp(6)

  allocations              HouseAllocation[]
  previousAllocations      HouseAllocation[]         @relation("AllocationPreviousHousehold")
  inspections              HouseInspection[]
  houseTerminationReceipts HouseTerminationReceipt[]

  @@unique([organizationId, hid])
  @@unique([organizationId, houseNumber])
  @@index([organizationId])
  @@index([status])
  @@index([houseType])
  @@index([locationId])
  @@map("households")
  @@schema("public")
}

// House Queue decision ledger / state machine.
// Stores ONLY decisions and snapshots - it never duplicates employee or
// household records. The priority engine (Engine A) and house recommendation
// (Engine B) are re-computed live on every read; this table persists the
// resulting allocation / skip / defer / release decisions so they survive
// recomputation and are fully auditable.
// The ledger is historied (append-only with updates): at most ONE row per
// employee per organization has status 'allocated' (enforced by the partial
// unique index), while any number of terminated rows remain for the Terminated
// Houses archive. A transfer is folded into this table as terminate-old +
// create-new within a single transaction.
model HouseAllocation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  employeeId     String  @db.Uuid
  householdId    String? @db.Uuid
  status         String  @default("ready_for_allocation") @db.VarChar(30)

  // Engine-verified snapshots at decision time (never authoritative - the
  // live engine always wins on read)
  recommendedHouseId String?   @db.Uuid
  mcdScore           Float?
  priorityRank       Int?
  reason             String?   @db.VarChar(500)
  decidedBy          String?   @db.Uuid
  decidedAt          DateTime? @db.Timestamp(6)

  // Termination (release-with-reason) fields. Populated once by the Queue
  // release action; archived by the Terminated Houses view. `householdId` is
  // retained on release so the archival record keeps "who lived where".
  terminationReason HouseTerminationReason?
  terminatedAt      DateTime?               @db.Timestamp(6)
  terminatedBy      String?                 @db.Uuid

  // Relocation (transfer / reassignment) history. Filled when the Queue
  // reassigns a live allocation to a different house: the vacated house is
  // frozen here so house-move prints and audits show former → new.
  previousHouseholdId String?   @db.Uuid
  movedAt             DateTime? @db.Timestamp(6)
  moveCount           Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee            Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  household           Household?                @relation(fields: [householdId], references: [id], onDelete: SetNull)
  householdPrev       Household?                @relation("AllocationPreviousHousehold", fields: [previousHouseholdId], references: [id], onDelete: SetNull)
  inspection          HouseInspection?
  terminationReceipts HouseTerminationReceipt[]

  @@index([organizationId, employeeId])
  @@index([organizationId])
  @@index([employeeId])
  @@index([householdId])
  @@index([status])
  @@map("house_allocations")
  @@schema("public")
}

// Inspection record raised the moment a house is vacated through the Release
// Workflow. Created 1:1 with the terminated (release) HouseAllocation row so
// "who vacated + what we found on handback" is one auditable pair. The house
// stays OUT of the Active pool from release until this inspection resolves it
// to `Active` (back into the pool) or `UnderMaintenance` (stays out of pool,
// damage checklist mirrored onto the household). Checkbox fields mirror the
// household damage taxonomy. Written exclusively by the inspection service.
model HouseInspection {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  // 1:1 link back to the terminated release row that produced this inspection.
  allocationId   String @unique @db.Uuid
  // Denormalized copy of allocation.householdId for direct worklist queries.
  householdId    String @db.Uuid

  // Scheduling (nullable until a Facility inspector is assigned a date)
  inspectorId   String?   @db.Uuid
  scheduledDate DateTime? @db.Date

  // Lifecycle of the inspection itself. The row is raised already SCHEDULED by
  // the release that produced it and only ever moves on to COMPLETED, so this is
  // a read-optimised duplicate of `resolvedTo`: a manager filtering the
  // worklist by lifecycle should not have to reason about two nullable columns.
  status String                  @default("SCHEDULED") @db.VarChar(20)
  // The exit branch that raised this inspection, copied from the release row so
  // a handback can be read without joining back to the allocation.
  reason HouseTerminationReason?

  // Handback checklist - mirrors the household damage taxonomy
  checklistWindow        Boolean @default(false)
  checklistDoor          Boolean @default(false)
  checklistWaterPanel    Boolean @default(false)
  checklistRoof          Boolean @default(false)
  checklistWall          Boolean @default(false)
  checklistElectricity   Boolean @default(false)
  // Inside-items checklist: the movable furniture that leaves with the tenant,
  // counted rather than flagged because "3 chairs" is the actual handback note.
  checklistBedCount      Int     @default(0) @db.Integer
  checklistChairsCount   Int     @default(0) @db.Integer
  checklistLockerCount   Int     @default(0) @db.Integer
  checklistTablesCount   Int     @default(0) @db.Integer
  checklistInsideItemsOk Boolean @default(true)

  // Repair cost per damaged part, in ETB. One column per part rather than a
  // free-text figure or a JSON blob, because these are money, they are queried
  // ("what did last year's handbacks cost"), and they are quoted line-by-line on
  // a signed receipt. Decimal(12,2) like every other money column — a float
  // would not survive being printed and re-read as a total.
  //
  // Zero means "not priced", which is only ever legal for an OK part: the
  // completion gate refuses a damaged part with no cost.
  costWindow      Decimal @default(0) @db.Decimal(12, 2)
  costDoor        Decimal @default(0) @db.Decimal(12, 2)
  costWaterPanel  Decimal @default(0) @db.Decimal(12, 2)
  costRoof        Decimal @default(0) @db.Decimal(12, 2)
  costWall        Decimal @default(0) @db.Decimal(12, 2)
  costElectricity Decimal @default(0) @db.Decimal(12, 2)
  // Denormalised sum of the per-part costs above, written in the same
  // transaction as them. Stored rather than derived so a receipt reprint is a
  // read, and so the printed total cannot disagree with the rows above it.
  totalDamageCost Decimal @default(0) @db.Decimal(12, 2)

  conditionNote String?  @db.VarChar(1000)
  photoUrls     String[]
  // Count of photos attached before retention rollup purged the URLs.
  photoCount    Int      @default(0) @db.Integer

  // Resolution (null = open / pending inspection)
  resolvedTo  String?   @db.VarChar(20)
  completedAt DateTime? @db.Timestamp(6)
  completedBy String?   @db.Uuid

  createdBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a completed inspection is permanent evidence that a
  // named house was inspected by a named inspector on a named date. Cascading
  // would let an ordinary DELETE /api/household destroy that record silently.
  allocation         HouseAllocation          @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  household          Household                @relation(fields: [householdId], references: [id], onDelete: Restrict)
  terminationReceipt HouseTerminationReceipt?

  @@index([organizationId])
  @@index([householdId])
  @@index([inspectorId])
  @@index([resolvedTo])
  @@index([status])
  @@map("house_inspections")
  @@schema("public")
}

// General Asset: non-IT fixed-asset inventory for the factory floor
// (SR No, Item Type, PID / Asset ID, Category, Location, Condition, Brand,
//  Reviews Date, Remark)
model GeneralAsset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  srNo         Int       @unique @default(autoincrement())
  itemType     String    @db.VarChar(100)
  pid          String    @db.VarChar(50)
  category     String    @db.VarChar(100)
  locationId   String?   @db.Uuid
  locationName String?   @db.VarChar(255)
  condition    String    @db.VarChar(50)
  brand        String?   @db.VarChar(100)
  reviewsDate  DateTime? @db.Date
  remark       String?   @db.VarChar(1000)

  // Multi-tenancy & audit
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       location?    @relation(fields: [locationId], references: [locationid], onDelete: SetNull)
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt @db.Timestamp(6)

  @@unique([organizationId, pid])
  @@index([organizationId])
  @@index([itemType])
  @@index([category])
  @@index([condition])
  @@index([locationId])
  @@index([reviewsDate])
  @@map("general_assets")
  @@schema("public")
}

// ────────────────────────────────────────────────────────────────────────────
// House Queue engine configuration (versioned, draft → preview → publish)
// ────────────────────────────────────────────────────────────────────────────

/**
 * Versioned engine configuration for the House Queue priority / house
 * recommendation system.
 * Lifecycle (DRAFT → ACTIVE, with history retained):
 * - at most ONE version per organization has status 'active' at a time, and
 * at most ONE has status 'draft' (enforced by partial unique indexes at the
 * DB level — Prisma cannot express those in schema.prisma),
 * - editing creates/updates a draft and never affects the live queue,
 * - publishing supersedes the previous active version — it is archived, never
 * deleted, so rollback means publishing a copy of an old version's payload
 * as a new version,
 * - the payload is stored per section as JSON so the whole history is
 * diffable and revertible.
 * The HouseAllocation decision ledger is deliberately EXCLUDED from the
 * retention policy configured here: allocations are governed by
 * `service.ts`, not by any retention/archive toggle on this page.
 */
model EngineConfigVersion {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String @db.Uuid
  versionNumber       Int    @db.Integer
  // draft | active | archived
  status              String @default("draft") @db.VarChar(20)
  weights             Json
  eligibilityBands    Json
  recommendationRules Json

  changeSummary  String?   @db.VarChar(1000)
  createdBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @db.Timestamp(6)
  publishedBy    String?   @db.Uuid
  publishedAt    DateTime? @db.Timestamp(6)
  // The version this one replaced (NULL for the first ever publish).
  supersededById String?   @db.Uuid

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEntries ConfigAuditEntry[]

  @@unique([organizationId, versionNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("engine_config_versions")
  @@schema("public")
}

/**
 * Append-only, FIELD-level audit trail for engine configuration changes.
 * One row per changed `fieldPath` (e.g. "weights.service_years"). Never
 * updated or deleted by any code path.
 */
model ConfigAuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  versionId      String   @db.Uuid
  // Dotted path into the config payload, e.g. "weights.service_years".
  fieldPath      String   @db.VarChar(200)
  oldValue       String?  @db.Text
  newValue       String?  @db.Text
  // draft_save | publish | rollback | manual_run | manual_purge | auto_run | auto_purge
  action         String   @db.VarChar(30)
  changedBy      String?  @db.Uuid
  changedAt      DateTime @default(now()) @db.Timestamp(6)
  ipAddress      String?  @db.VarChar(64)
  changeSummary  String?  @db.VarChar(1000)

  version      EngineConfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId, versionId])
  @@index([organizationId, changedAt])
  @@index([action])
  @@map("config_audit_entries")
  @@schema("public")
}

/**
 * Cold-storage copy of a resolved `HouseInspection` that has exceeded its
 * warm retention window with cold archive enabled. Written by the retention
 * purge job; the original row is then deleted. Fields mirror
 * `HouseInspection` plus provenance metadata.
 */
model HouseInspectionArchive {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  allocationId  String    @db.Uuid
  householdId   String    @db.Uuid
  inspectorId   String?   @db.Uuid
  scheduledDate DateTime? @db.Date

  checklistWindow      Boolean  @default(false)
  checklistDoor        Boolean  @default(false)
  checklistWaterPanel  Boolean  @default(false)
  checklistRoof        Boolean  @default(false)
  checklistWall        Boolean  @default(false)
  checklistElectricity Boolean  @default(false)
  // Repair costs travel with the checklist into the archive: an archived
  // handback that kept the damage but dropped the money would be evidence for a
  // dispute it can no longer answer.
  costWindow           Decimal  @default(0) @db.Decimal(12, 2)
  costDoor             Decimal  @default(0) @db.Decimal(12, 2)
  costWaterPanel       Decimal  @default(0) @db.Decimal(12, 2)
  costRoof             Decimal  @default(0) @db.Decimal(12, 2)
  costWall             Decimal  @default(0) @db.Decimal(12, 2)
  costElectricity      Decimal  @default(0) @db.Decimal(12, 2)
  totalDamageCost      Decimal  @default(0) @db.Decimal(12, 2)
  conditionNote        String?  @db.VarChar(1000)
  photoUrls            String[]
  photoCount           Int      @default(0) @db.Integer

  resolvedTo  String?   @db.VarChar(20)
  completedAt DateTime? @db.Timestamp(6)
  completedBy String?   @db.Uuid
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @db.Timestamp(6)

  // Provenance — how this row was archived and when.
  coldCompression String   @default("none") @db.VarChar(20)
  archivedAt      DateTime @default(now()) @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([householdId])
  @@index([archivedAt])
  @@map("house_inspection_archives")
  @@schema("public")
}

// ────────────────────────────────────────────────────────────────────────────
// Pay Rent — leases on shops, groceries and other premises rented to external
// parties. The House Queue allocates staff houses and models OCCUPANCY; these
// leases carry a recurring monthly price and therefore need a real payment
// ledger (schedule + receipts) rather than an allocation state machine.
//
// Money is Decimal(12,2) everywhere — no float column exists. Financial rows
// are never hard-deleted: renters archive via `deletedAt`, installments are
// VOIDED, payments keep their receipt number forever. Every FK inside the
// ledger is RESTRICT so a careless DELETE loses on the constraint instead of
// silently orphaning an amount already reported to the treasury.
// ────────────────────────────────────────────────────────────────────────────

/**
 * A person renting premises from the factory, with their lease terms.
 * The one-live-renter-per-National-ID guarantee is a partial unique index
 * (`WHERE deletedAt IS NULL`), which Prisma cannot express. Archiving a renter
 * therefore frees the National ID for a new registration while the archived
 * record keeps its history.
 */
model RentRenter {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  firstName      String          @db.VarChar(50)
  lastName       String          @db.VarChar(50)
  gender         Gender
  // Digits only — a CHECK constraint, not just Zod, so personal-data hygiene is
  // a storage guarantee rather than an application convention.
  nationalId     String          @db.VarChar(64)
  rentType       RentType
  // Required whenever rentType is `Other`; a leftover description on a Shop is
  // allowed so adding a helpful note is not rejected.
  rentTypeDetail String?         @db.VarChar(200)
  monthlyPrice   Decimal         @db.Decimal(12, 2)
  startDate      DateTime        @db.Date
  termMonths     Int             @db.SmallInt
  endDate        DateTime        @db.Date
  status         RentLeaseStatus @default(Active)

  terminatedAt      DateTime? @db.Timestamp(6)
  terminatedById    String?   @db.Uuid
  terminationReason String?   @db.VarChar(500)
  archivedReason    String?   @db.VarChar(500)
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime? @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @db.Timestamp(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phones       RentRenterPhone[]
  installments RentInstallment[]
  payments     RentPayment[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, status])
  @@index([organizationId, rentType])
  @@index([organizationId, gender])
  @@index([organizationId, startDate])
  @@index([organizationId, nationalId])
  @@map("rent_renters")
  @@schema("public")
}

/**
 * Renter contact numbers in E.164 form. Personal data: never written to the
 * application log. The "at most three phones" and "exactly one primary" rules
 * are enforced by a partial unique index and by the service layer, because a
 * CHECK cannot contain a subquery and this codebase avoids triggers.
 */
model RentRenterPhone {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  renterId       String   @db.Uuid
  phone          String   @db.VarChar(20)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  renter       RentRenter   @relation(fields: [renterId], references: [id], onDelete: Restrict)

  @@unique([renterId, phone])
  @@index([organizationId, phone])
  @@map("rent_renter_phones")
  @@schema("public")
}

/**
 * One month of rent for one renter.
 * The schedule is materialised eagerly: creating a renter writes one row per
 * month of the term in the same transaction, so there is never a lease without
 * a schedule. `amountDue` is a snapshot of the price at generation time.
 * Overdue is derived from `dueDate` + today on read and is never stored.
 */
model RentInstallment {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  renterId       String                @db.Uuid
  monthNumber    Int                   @db.SmallInt
  dueDate        DateTime              @db.Date
  amountDue      Decimal               @db.Decimal(12, 2)
  status         RentInstallmentStatus @default(UNPAID)

  // A PAID month must be fully stamped (CHECK-enforced): that is what makes
  // "total paid" trustworthy without joining the receipt table.
  paidAt          DateTime?          @db.Date
  paidById        String?            @db.Uuid
  receiptNumber   String?            @db.VarChar(40)
  paymentMethod   RentPaymentMethod?
  referenceNumber String?            @db.VarChar(100)
  note            String?            @db.VarChar(500)

  // VOIDED is a deliberate, reason-bearing act — same policy as terminate.
  voidedAt   DateTime? @db.Timestamp(6)
  voidedById String?   @db.Uuid
  voidReason String?   @db.VarChar(500)

  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  renter       RentRenter    @relation(fields: [renterId], references: [id], onDelete: Restrict)
  payments     RentPayment[]

  // The double-pay guard: a month can exist only once per renter.
  @@unique([renterId, monthNumber])
  @@index([organizationId, status, dueDate])
  @@index([renterId, status, monthNumber])
  @@index([renterId, dueDate])
  @@map("rent_installments")
  @@schema("public")
}

/**
 * Append-only rent receipt. A void sets `voidedAt`/`voidedById`/`voidReason`
 * and reverts the installment to UNPAID; the row is never deleted, so a receipt
 * number is never re-issued and the treasury's record stays complete.
 * At most one LIVE payment may settle a month — a partial unique index on
 * `installmentId WHERE voidedAt IS NULL`. Voided payments are excluded so a
 * month can legitimately be re-paid after a void.
 */
model RentPayment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String            @db.Uuid
  renterId        String            @db.Uuid
  installmentId   String            @db.Uuid
  // Shape RENT-2026-000123, CHECK-enforced so a malformed receipt can never
  // reach the treasury even via a direct write.
  receiptNumber   String            @db.VarChar(40)
  amount          Decimal           @db.Decimal(12, 2)
  paidOn          DateTime          @db.Date
  method          RentPaymentMethod
  referenceNumber String?           @db.VarChar(100)
  note            String?           @db.VarChar(500)

  voidedAt   DateTime? @db.Timestamp(6)
  voidedById String?   @db.Uuid
  voidReason String?   @db.VarChar(500)

  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  renter       RentRenter      @relation(fields: [renterId], references: [id], onDelete: Restrict)
  installment  RentInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@index([renterId, paidOn])
  @@index([installmentId])
  @@index([organizationId, voidedAt, paidOn])
  @@map("rent_payments")
  @@schema("public")
}

/**
 * Per-organization, per-year receipt counter. Allocated with
 * `INSERT .. ON CONFLICT DO UPDATE`, which is concurrency-safe without locking
 * the counter table for the duration of a transaction.
 */
model RentReceiptSequence {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  year           Int      @db.SmallInt
  lastValue      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@map("rent_receipt_sequences")
  @@schema("public")
}
