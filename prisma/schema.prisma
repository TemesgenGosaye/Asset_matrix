generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ────────────────────────────────────────────────────────────────────────────
// Housing lifecycle enums
// ────────────────────────────────────────────────────────────────────────────

/**
 * Physical occupancy state of a house. Mirrors the House Hold Register:
 * a house is Occupied only while a live (`allocated`) HouseAllocation points
 * at it, Vacant when released back to the pool, and Maintenance while the
 * register marks it Inactive (damage checklist). Written exclusively from the
 * Queue decision service and the register's activate/deactivate path.
 */
enum HouseOccupancyStatus {
  Vacant
  Occupied
  Maintenance

  @@schema("public")
}

/**
 * Coded reason an allocation was terminated (release with a reason). The Queue
 * release action is the only place these are written. HR exit types:
 * TRANSFER, EMPLOYEE_LEAVE, RETIREMENT.
 */
enum HouseTerminationReason {
  TRANSFER
  EMPLOYEE_LEAVE
  RETIREMENT

  @@schema("public")
}

/**
 * Gender enum for employees. Member names are lowercase to match the House
 * Queue MCDA scoring engine lookup tables.
 */
enum Gender {
  male
  female

  @@schema("public")
}

/**
 * Marital status enum for employees. Member names are lowercase to match the
 * House Queue MCDA scoring engine lookup tables.
 */
enum MaritalStatus {
  single
  married

  @@schema("public")
}

/**
 * Kind of premises rented out by the factory (Pay Rent module). `Other` is only
 * valid when `rentTypeDetail` explains what is being rented.
 */
enum RentType {
  Shop
  Grocery
  Other

  @@schema("public")
}

/**
 * Persisted month state for one lease installment. OVERDUE is deliberately
 * absent: it is derived from `dueDate` + today on read and never stored, so it
 * cannot drift away from the schedule.
 */
enum RentInstallmentStatus {
  UNPAID
  PAID
  VOIDED

  @@schema("public")
}

/**
 * How a rent receipt was settled.
 */
enum RentPaymentMethod {
  Cash
  BankTransfer
  Other

  @@schema("public")
}

/**
 * Persisted lease state. Overdue is a display state derived from installments.
 */
enum RentLeaseStatus {
  Active
  Completed
  Terminated

  @@schema("public")
}

// Multi-tenancy: Organization model
model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(50)
  description String?
  settings    Json?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
  isActive    Boolean  @default(true)

  // Relationships
  users           user[]
  departments     Department[]
  assets          asset[]
  accessories     accessories[]
  licences        licence[]
  consumables     consumable[]
  components      Component[]
  roles           Role[]
  webhooks        Webhook[]
  teamInvitations TeamInvitation[]
  kits            Kit[]
  auditCampaigns  AuditCampaign[]

  // Shared-table relations (org-scoped)
  manufacturers            manufacturer[]
  suppliers                supplier[]
  models                   model[]
  locations                location[]
  statusTypes              statusType[]
  assetCategories          assetCategoryType[]
  accessoryCategories      accessorieCategoryType[]
  consumableCategories     consumableCategoryType[]
  licenceCategories        licenceCategoryType[]
  componentCategories      ComponentCategory[]
  scimTokens               ScimToken[]
  purchaseRequests         PurchaseRequest[]
  purchaseOrders           PurchaseOrder[]
  employees                Employee[]
  households               Household[]
  generalAssets            GeneralAsset[]
  houseAllocations         HouseAllocation[]
  houseInspections         HouseInspection[]
  houseInspectionArchives  HouseInspectionArchive[]
  engineConfigVersions     EngineConfigVersion[]
  engineConfigAuditEntries ConfigAuditEntry[]
  houseRequests            HouseRequest[]
  houseTerminationReceipts HouseTerminationReceipt[]
  rentRenters              RentRenter[]
  rentRenterPhones         RentRenterPhone[]
  rentInstallments         RentInstallment[]
  rentPayments             RentPayment[]
  rentReceiptSequences     RentReceiptSequence[]

  @@map("organizations")
  @@schema("public")
}

// Multi-tenancy: Department model (hierarchical)
model Department {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String       @db.VarChar(100)
  code           String?      @db.VarChar(20)
  description    String?
  isActive       Boolean      @default(true)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?      @db.Uuid
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt @db.Timestamp(6)

  // Relationships
  users            user[]
  purchaseRequests PurchaseRequest[]
  employees        Employee[]
  assets           asset[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([parentId])
  @@index([code])
  @@index([isActive])
  @@map("departments")
  @@schema("public")
}

// RBAC: Role model
model Role {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String        @db.VarChar(100)
  description    String?
  permissions    String[]
  isSystem       Boolean       @default(false)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt @db.Timestamp(6)

  userRoles       UserRole[]
  teamInvitations TeamInvitation[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
  @@schema("public")
}

// RBAC: UserRole junction model
model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      user     @relation(fields: [userId], references: [userid], onDelete: Cascade)
  roleId    String   @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now()) @db.Timestamp(6)
  grantedBy String?  @db.Uuid

  @@unique([userId, roleId])
  @@map("user_roles")
  @@schema("public")
}

// Webhook System
model Webhook {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String        @db.VarChar(100)
  url            String        @db.VarChar(500)
  secret         String?       @db.VarChar(255)
  events         String[]
  isActive       Boolean       @default(true)
  retryAttempts  Int           @default(3)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt @db.Timestamp(6)

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@index([isActive])
  @@index([organizationId, isActive])
  @@map("webhooks")
  @@schema("public")
}

model WebhookDelivery {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhookId   String   @db.Uuid
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String   @db.VarChar(100)
  payload     Json
  statusCode  Int?
  response    String?
  attempt     Int      @default(1)
  success     Boolean  @default(false)
  deliveredAt DateTime @default(now()) @db.Timestamp(6)
  error       String?

  @@index([webhookId])
  @@index([deliveredAt])
  @@map("webhook_deliveries")
  @@schema("public")
}

// SCIM Token (per-org bearer tokens for SCIM provisioning)
model ScimToken {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String       @db.VarChar(255)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String?      @db.VarChar(255)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  createdBy      String?      @db.Uuid

  @@index([organizationId])
  @@map("scim_tokens")
  @@schema("public")
}

// Asset Reservation/Booking System
model AssetReservation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId    String    @db.Uuid
  asset      asset     @relation(fields: [assetId], references: [assetid], onDelete: Cascade)
  userId     String    @db.Uuid
  user       user      @relation(fields: [userId], references: [userid], onDelete: Cascade)
  startDate  DateTime  @db.Timestamp(6)
  endDate    DateTime  @db.Timestamp(6)
  status     String    @default("pending") @db.VarChar(20)
  notes      String?
  approvedBy String?   @db.Uuid
  approvedAt DateTime? @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt @db.Timestamp(6)

  @@index([assetId])
  @@index([userId])
  @@index([status])
  @@index([assetId, status])
  @@map("asset_reservations")
  @@schema("public")
}

// Asset Transfer Log
model AssetTransfer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId        String   @db.Uuid
  asset          asset    @relation(fields: [assetId], references: [assetid], onDelete: Cascade)
  transferType   String   @db.VarChar(20) // user, location, organization
  fromUserId     String?  @db.Uuid
  toUserId       String?  @db.Uuid
  fromLocationId String?  @db.Uuid
  toLocationId   String?  @db.Uuid
  fromOrgId      String?  @db.Uuid
  toOrgId        String?  @db.Uuid
  reason         String?
  transferredBy  String   @db.Uuid
  transferredAt  DateTime @default(now()) @db.Timestamp(6)

  @@index([assetId])
  @@index([transferredAt])
  @@map("asset_transfers")
  @@schema("public")
}

// Approval Workflow
model ApprovalRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String    @db.VarChar(50) // reservation, asset_request, transfer
  entityId    String    @db.Uuid
  requesterId String    @db.Uuid
  requester   user      @relation("approval_requester", fields: [requesterId], references: [userid], onDelete: Cascade)
  approverId  String?   @db.Uuid
  approver    user?     @relation("approval_approver", fields: [approverId], references: [userid])
  status      String    @default("pending") @db.VarChar(20) // pending, approved, rejected
  notes       String?
  resolvedAt  DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  @@index([requesterId])
  @@index([status])
  @@index([approverId])
  @@map("approval_requests")
  @@schema("public")
}

// Automation Rules / Workflows Engine
model AutomationRule {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(200)
  description String?
  trigger     String    @db.VarChar(50) // warranty_expiring, maintenance_due, asset_status_change, license_expiring, stock_low
  conditions  String    @db.Text // JSON: conditions to evaluate
  actions     String    @db.Text // JSON: actions to take (notify, update_status, create_ticket, etc.)
  isActive    Boolean   @default(true)
  lastRunAt   DateTime? @db.Timestamp(6)
  runCount    Int       @default(0)
  createdBy   String    @db.Uuid
  creator     user      @relation("automation_creator", fields: [createdBy], references: [userid], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  @@index([trigger])
  @@index([isActive])
  @@map("automation_rules")
  @@schema("public")
}

// Stock Alert Configuration
model StockAlert {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumableId      String     @unique @db.Uuid
  consumable        consumable @relation(fields: [consumableId], references: [consumableid], onDelete: Cascade)
  minThreshold      Int        @default(10)
  criticalThreshold Int        @default(5)
  emailNotify       Boolean    @default(true)
  webhookNotify     Boolean    @default(false)
  lastAlertSentAt   DateTime?  @db.Timestamp(6)
  createdAt         DateTime   @default(now()) @db.Timestamp(6)
  updatedAt         DateTime   @updatedAt @db.Timestamp(6)

  @@map("stock_alerts")
  @@schema("public")
}

// Bulk Import Jobs
model ImportJob {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  user          user      @relation(fields: [userId], references: [userid], onDelete: Cascade)
  entityType    String    @db.VarChar(50)
  fileName      String    @db.VarChar(255)
  fileSize      Int
  totalRows     Int       @default(0)
  processedRows Int       @default(0)
  successCount  Int       @default(0)
  errorCount    Int       @default(0)
  status        String    @default("pending") @db.VarChar(20)
  errors        Json?
  startedAt     DateTime? @db.Timestamp(6)
  completedAt   DateTime? @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @db.Timestamp(6)

  @@index([userId])
  @@map("import_jobs")
  @@schema("public")
}

model accessorieCategoryType {
  accessoriecategorytypeid   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessoriecategorytypename String        @db.VarChar
  organizationId             String?       @db.Uuid
  organization               Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessories                accessories[]

  @@index([organizationId])
  @@schema("public")
}

model accessories {
  accessorieid             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessoriename           String                 @db.VarChar
  accessorietag            String                 @db.VarChar
  purchaseprice            Decimal?               @db.Decimal(10, 2)
  purchasedate             DateTime?              @db.Date
  requestable              Boolean?
  manufacturerid           String                 @db.Uuid
  statustypeid             String                 @db.Uuid
  accessoriecategorytypeid String                 @db.Uuid
  locationid               String                 @db.Uuid
  supplierid               String                 @db.Uuid
  modelid                  String                 @db.Uuid
  organizationId           String?                @db.Uuid
  creation_date            DateTime               @db.Timestamp(6)
  change_date              DateTime?              @db.Timestamp(6)
  accessorieCategoryType   accessorieCategoryType @relation(fields: [accessoriecategorytypeid], references: [accessoriecategorytypeid], onDelete: NoAction, onUpdate: NoAction, map: "fk_accessories_accessoriecategorytype_c_accessoriecategorytypei")
  location                 location               @relation(fields: [locationid], references: [locationid], onDelete: NoAction, onUpdate: NoAction, map: "fk_accessories_location_c_locationid")
  manufacturer             manufacturer           @relation(fields: [manufacturerid], references: [manufacturerid], onDelete: NoAction, onUpdate: NoAction, map: "fk_accessories_manufacturer_c_manufacturerid")
  model                    model                  @relation(fields: [modelid], references: [modelid], onDelete: NoAction, onUpdate: NoAction, map: "fk_accessories_model_c_modelid")
  organization             Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statusType               statusType             @relation(fields: [statustypeid], references: [statustypeid], onDelete: NoAction, onUpdate: NoAction, map: "fk_accessories_statustype_c_statustypeid")
  supplier                 supplier               @relation(fields: [supplierid], references: [supplierid], onDelete: NoAction, onUpdate: NoAction, map: "fk_accessories_supplier_c_supplierid")
  userAccessoires          userAccessoires[]

  @@index([organizationId])
  @@index([manufacturerid])
  @@index([statustypeid])
  @@index([accessoriecategorytypeid])
  @@index([locationid])
  @@index([supplierid])
  @@index([modelid])
  @@schema("public")
}

model accounts {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
  user                  user      @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("public")
}

model asset {
  assetid                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetname                String                  @db.VarChar
  assettag                 String                  @unique @db.VarChar
  serialnumber             String                  @unique @db.VarChar
  modelid                  String?                 @db.Uuid
  specs                    String?
  notes                    String?
  purchaseprice            Decimal?                @db.Decimal(10, 2)
  purchasedate             DateTime?               @db.Date
  mobile                   Boolean?
  requestable              Boolean?
  assetcategorytypeid      String?                 @db.Uuid
  statustypeid             String?                 @db.Uuid
  supplierid               String?                 @db.Uuid
  locationid               String?                 @db.Uuid
  manufacturerid           String?                 @db.Uuid
  organizationId           String?                 @db.Uuid
  creation_date            DateTime                @db.Timestamp(6)
  change_date              DateTime?               @db.Timestamp(6)
  expectedEndOfLife        DateTime?               @db.Date
  warrantyExpires          DateTime?               @db.Date
  warrantyMonths           Int?
  reviewsDate              DateTime?               @db.Date
  remark                   String?
  departmentId             String?                 @db.Uuid
  departmentCode           String?                 @db.VarChar(20)
  externalId               String?                 @db.VarChar(255)
  externalSource           String?                 @db.VarChar(30)
  assetCategoryType        assetCategoryType?      @relation(fields: [assetcategorytypeid], references: [assetcategorytypeid], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_assetcategorytype_c_assetcategorytypeid")
  location                 location?               @relation(fields: [locationid], references: [locationid], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_location_c_locationid")
  manufacturer             manufacturer?           @relation(fields: [manufacturerid], references: [manufacturerid], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_manufacturer_c_manufacturerid")
  model                    model?                  @relation(fields: [modelid], references: [modelid], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_model_c_modelid")
  organization             Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statusType               statusType?             @relation(fields: [statustypeid], references: [statustypeid], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_statustype_c_statustypeid")
  supplier                 supplier?               @relation(fields: [supplierid], references: [supplierid], onDelete: NoAction, onUpdate: NoAction, map: "fk_asset_supplier_c_supplierid")
  department               Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  asset_attachments        asset_attachments[]
  maintenance_schedules    maintenance_schedules[]
  reservations             AssetReservation[]
  transfers                AssetTransfer[]
  checkouts                AssetCheckout[]
  checkoutsReceivedAsAsset AssetCheckout[]         @relation("checkout_to_asset")
  componentCheckouts       ComponentCheckout[]
  userAssets               userAssets[]
  auditEntries             AuditEntry[]

  @@index([assetname])
  @@index([statustypeid])
  @@index([assetcategorytypeid])
  @@index([locationid])
  @@index([organizationId])
  @@index([creation_date])
  @@index([modelid])
  @@index([supplierid])
  @@index([manufacturerid])
  @@index([departmentId])
  @@index([organizationId, creation_date])
  @@index([externalId])
  @@index([externalSource])
  @@schema("public")
}

model IntuneSyncLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @db.Uuid
  status         String   @db.VarChar(20)
  devicesCreated Int      @default(0)
  devicesUpdated Int      @default(0)
  devicesSkipped Int      @default(0)
  errors         Json?
  triggeredBy    String?  @db.VarChar(50)
  durationMs     Int?
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  @@index([createdAt])
  @@map("intune_sync_logs")
  @@schema("public")
}

model AssetTemplate {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(200)
  description         String?
  assetcategorytypeid String?  @db.Uuid
  manufacturerid      String?  @db.Uuid
  modelid             String?  @db.Uuid
  statustypeid        String?  @db.Uuid
  locationid          String?  @db.Uuid
  supplierid          String?  @db.Uuid
  defaultSpecs        String?
  defaultNotes        String?
  isActive            Boolean  @default(true)
  organizationId      String?  @db.Uuid
  createdBy           String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @db.Timestamp(6)

  @@index([organizationId])
  @@map("asset_templates")
  @@schema("public")
}

model assetCategoryType {
  assetcategorytypeid   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetcategorytypename String                 @db.VarChar
  assetTypeCode         String?                @db.VarChar(50)
  organizationId        String?                @db.Uuid
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset                 asset[]
  depreciation_settings depreciation_settings?

  @@index([organizationId])
  @@index([assetTypeCode])
  @@schema("public")
}

model AssetPidSequence {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetTypeCode  String   @db.VarChar(50)
  departmentCode String   @db.VarChar(50)
  lastSequence   Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  @@unique([assetTypeCode, departmentCode])
  @@map("asset_pid_sequences")
  @@schema("public")
}

model asset_attachments {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId       String   @db.Uuid
  filename      String   @db.VarChar(255)
  originalName  String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  size          Int
  path          String   @db.VarChar(500)
  thumbnailPath String?  @db.VarChar(500)
  isPrimary     Boolean  @default(false)
  uploadedBy    String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  asset         asset    @relation(fields: [assetId], references: [assetid], onDelete: Cascade)
  user          user?    @relation(fields: [uploadedBy], references: [userid])

  @@index([assetId])
  @@schema("public")
}

model audit_logs {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @db.Uuid
  details   String?
  ipAddress String?  @db.VarChar(50)
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      user?    @relation(fields: [userId], references: [userid])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([userId, createdAt])
  @@schema("public")
}

model consumable {
  consumableid             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumablename           String                 @db.VarChar
  consumablecategorytypeid String                 @db.Uuid
  manufacturerid           String                 @db.Uuid
  supplierid               String                 @db.Uuid
  purchaseprice            Decimal?               @db.Decimal(10, 2)
  purchasedate             DateTime?              @db.Date
  organizationId           String?                @db.Uuid
  creation_date            DateTime               @db.Timestamp(6)
  change_date              DateTime?              @db.Timestamp(6)
  minQuantity              Int                    @default(0)
  quantity                 Int                    @default(0)
  consumableCategoryType   consumableCategoryType @relation(fields: [consumablecategorytypeid], references: [consumablecategorytypeid], onDelete: NoAction, onUpdate: NoAction, map: "fk_consumable_consumablecategorytype_c_consumablecategorytypeid")
  manufacturer             manufacturer           @relation(fields: [manufacturerid], references: [manufacturerid], onDelete: NoAction, onUpdate: NoAction, map: "fk_consumable_manufacturer_c_manufacturerid")
